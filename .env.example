# Generate a random string: python -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_AUTH_TOKEN=replace-with-random-secret-at-least-24-characters
# Without this key only accessible YouTube captions are processed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_CAPTION_CHARS=90000
PORT=8000

# Optional Google-independent text AI, suitable for supported Yandex Cloud users:
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1
# Optional OpenAI-compatible alternative (server configuration only):
TEXT_AI_API_KEY=
TEXT_AI_MODEL=
TEXT_AI_BASE_URL=
