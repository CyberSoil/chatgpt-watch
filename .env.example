# Generate a random string: python -c 'import secrets; print(secrets.token_urlsafe(32))'
MCP_AUTH_TOKEN=replace-with-random-secret-at-least-24-characters
# Without this key only accessible YouTube captions are processed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_CAPTION_CHARS=90000
PORT=8000
